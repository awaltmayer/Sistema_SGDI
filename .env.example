# ==========================================
# SGDI - Variáveis de Ambiente de Exemplo
# ==========================================
# Copie este arquivo para .env e preencha com as credenciais do seu projeto Supabase:
# cp .env.example .env

# URL da API do projeto Supabase (Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL="https://seu-projeto.supabase.co"

# Chave pública / Publishable Key (Anon Key)
VITE_SUPABASE_PUBLISHABLE_KEY="sua-chave-anonima-publica-jwt-ou-sb_publishable_aqui"

# ID do Projeto (opcional, para referência)
VITE_SUPABASE_PROJECT_ID="seu-id-de-projeto"
